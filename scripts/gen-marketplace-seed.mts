/**
 * Generates supabase/migrations/20261112000100_seed_sample_marketplace.sql from the in-code sample data,
 * so the database and the fallback data can never drift apart.
 *   node scripts/gen-marketplace-seed.mts
 */
import { writeFileSync } from "node:fs";
import { LOADS, TRUCKS, LOAD_PRIVATE, TRUCK_PRIVATE, SAMPLE_CONTACT } from "../src/lib/marketplace.ts";

const q = (v: string | number | null | undefined) => (v === null || v === undefined ? "null" : typeof v === "number" ? String(v) : `'${v.replace(/'/g, "''")}'`);
const arr = (a: readonly string[]) => (a.length ? `array[${a.map((x) => q(x)).join(",")}]::text[]` : "'{}'::text[]");

const out: string[] = [
  "-- Sample marketplace listings (is_sample = true). Generated by scripts/gen-marketplace-seed.mts — do not edit by hand.",
  "-- Illustrative only: company names are fictional and every contact routes through the Encore desk.",
  "-- Idempotent: re-running does nothing for references that already exist.",
  "",
];

const loadCols = "reference,status,is_sample,corridor,origin_city,origin_country,destination_city,destination_country,distance_km,transit_days_min,transit_days_max,borders,commodity_en,commodity_sw,cargo_type,packaging,weight_t,volume_cbm,piece_dimensions,vehicle_type,trucks_needed,pickup_from_offset,pickup_to_offset,deliver_by_offset,posted_hours_ago,budget_min_usd,budget_max_usd,temp_min_c,temp_max_c,hazmat_class,requirements,documents,note_en,note_sw,urgent,sector";
const loadRows = LOADS.map((l) => `(${[q(l.ref), "'published'", "true", q(l.corridor), q(l.origin.city), q(l.origin.cc), q(l.destination.city), q(l.destination.cc), l.km, l.transit[0], l.transit[1], arr(l.borders), q(l.commodity.en), q(l.commodity.sw), q(l.cargoType), q(l.packaging), l.weightT, q(l.volumeCbm ?? null), q(l.piece ?? null), q(l.truckType), l.trucks, l.pickup[0], l.pickup[1], l.deliveryBy, l.postedHoursAgo, l.budget[0], l.budget[1], q(l.temp?.[0] ?? null), q(l.temp?.[1] ?? null), q(l.hazmat ?? null), arr(l.reqs), arr(l.docs), q(l.note?.en ?? null), q(l.note?.sw ?? null), l.urgent ? "true" : "false", q(l.sector)].join(",")})`);
out.push(`insert into public.cargo_requests (${loadCols}) values`, loadRows.join(",\n"), "on conflict (reference) do nothing;", "");

const loadPriv = LOADS.map((l) => { const [c, a, b] = LOAD_PRIVATE[l.ref]; return `(${[q(l.ref), q(c), q(a), q(b)].join(",")})`; });
out.push(
  "insert into public.cargo_request_private (cargo_request_id,company_name,contact_name,contact_phone,contact_email,pickup_address,delivery_address)",
  `select r.id, v.company, ${q(SAMPLE_CONTACT.name)}, ${q(SAMPLE_CONTACT.phone)}, ${q(SAMPLE_CONTACT.email)}, v.pickup, v.delivery`,
  `from (values ${loadPriv.join(",\n  ")}) as v(ref, company, pickup, delivery)`,
  "join public.cargo_requests r on r.reference = v.ref",
  "on conflict (cargo_request_id) do nothing;",
  "",
);

const truckCols = "reference,status,is_sample,vehicle_type,make_model,year,axle_configuration,payload_t,body_spec,location_city,location_country,available_offset,posted_hours_ago,corridors,features,rate_min_usd_per_km,rate_max_usd_per_km";
const truckRows = TRUCKS.map((t) => `(${[q(t.ref), "'published'", "true", q(t.type), q(t.make), t.year, q(t.axles), t.payloadT, q(t.body), q(t.location.city), q(t.location.cc), t.availIn, t.postedHoursAgo, arr(t.routes), arr(t.features), t.rate[0], t.rate[1]].join(",")})`);
out.push(`insert into public.trucks (${truckCols}) values`, truckRows.join(",\n"), "on conflict (reference) do nothing;", "");

const truckPriv = TRUCKS.map((t) => { const [c, b] = TRUCK_PRIVATE[t.ref]; return `(${[q(t.ref), q(c), q(b)].join(",")})`; });
out.push(
  "insert into public.truck_private (truck_id,company_name,contact_name,contact_phone,contact_email,base_address)",
  `select t.id, v.company, ${q(SAMPLE_CONTACT.name)}, ${q(SAMPLE_CONTACT.phone)}, ${q(SAMPLE_CONTACT.email)}, v.base`,
  `from (values ${truckPriv.join(",\n  ")}) as v(ref, company, base)`,
  "join public.trucks t on t.reference = v.ref",
  "on conflict (truck_id) do nothing;",
  "",
);

writeFileSync(new URL("../supabase/migrations/20261112000100_seed_sample_marketplace.sql", import.meta.url), out.join("\n"));
console.log(`seed: ${LOADS.length} loads, ${TRUCKS.length} trucks`);
